# App (Remix/Shopify)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=write_products
SHOPIFY_BILLING_TEST_MODE=false

# Smart Crop API integration
SMARTCROP_API_URL=https://your-smartcrop-api.example.com
SMARTCROP_API_TOKEN=replace_with_a_secure_token

# Database (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# FastAPI service
SMARTCROP_FRONTEND_ORIGINS=https://your-app.example.com
DOWNLOAD_BASE_URL=https://your-smartcrop-api.example.com
